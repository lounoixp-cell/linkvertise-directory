# ==============================================================================
# Linkvertise Directory - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production on Vercel, configure these variables in Project Settings > Environment Variables.
#
# IMPORTANT SECURITY DIRECTIVE:
# - Only variables prefixed with NEXT_PUBLIC_ are bundled into browser-accessible code.
# - Private server secrets must NEVER use NEXT_PUBLIC_ prefix or be imported in client components.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
# These variables are safe to expose to the client browser and are prefixed with NEXT_PUBLIC_.

# Sanity CMS Project ID (found in Sanity Management Dashboard)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here

# Sanity CMS Dataset (e.g., 'production' or 'development')
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Version date string (YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION=2024-11-01


# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER SECRETS (NEVER EXPOSE TO BROWSER / CLIENT BUNDLES)
# ------------------------------------------------------------------------------
# These credentials must remain strictly server-side.
# Never prefix these variables with NEXT_PUBLIC_ or reference them in client components.

# Sanity API Read/Write Token for authenticated queries & mutations (server only)
SANITY_API_TOKEN=your_sanity_api_token_here

# Secret used to authenticate on-demand ISR webhook requests at /api/revalidate
SANITY_REVALIDATE_SECRET=your_sanity_webhook_revalidation_secret_here

# Resend API Key for dispatching transactional feedback emails (re_...)
RESEND_API_KEY=your_resend_api_key_here

# Destination email inbox where user feedback submissions will be delivered
FEEDBACK_EMAIL=feedback@example.com

# Verified sender address for outgoing transactional emails
FEEDBACK_FROM_EMAIL=Linkvertise Directory <onboarding@resend.dev>
